 121          /********************* UART1中断函数************************/
 122          void UART1_int (void) interrupt UART1_VECTOR
 123          {
 124   1        if(RI)
 125   1        {
 126   2          RI = 0;
 127   2          if(COM1.B_RX_OK == 0)
 128   2          {
 129   3            if(COM1.RX_Cnt >= COM_RX1_Lenth)  COM1.RX_Cnt = 0;
 130   3            RX1_Buffer[COM1.RX_Cnt++] = SBUF;
 131   3            COM1.RX_TimeOut = TimeOutSet1;
 132   3          }
 133   2        }
 134   1      
 135   1        if(TI)
 136   1        {
 137   2          TI = 0;
 138   2          if(COM1.TX_read != COM1.TX_write)
 139   2          {
 140   3            SBUF = TX1_Buffer[COM1.TX_read];
 141   3            if(++COM1.TX_read >= COM_TX1_Lenth)   COM1.TX_read = 0;
 142   3          }
 143   2          else  COM1.B_TX_busy = 0;
 144   2        }
 145   1      }
