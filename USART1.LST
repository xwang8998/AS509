 100          /*************** 装载串口发送缓冲 *******************************/
 101          
 102          void TX1_write2buff(u8 dat) //写入发送缓冲，指针+1
 103          {
 104   1        TX1_Buffer[COM1.TX_write] = dat;  //装发送缓冲
 105   1        if(++COM1.TX_write >= COM_TX1_Lenth)  COM1.TX_write = 0;
 106   1      
 107   1        if(COM1.B_TX_busy == 0)   //空闲
 108   1        {  
 109   2          COM1.B_TX_busy = 1;   //标志忙
 110   2          TI = 1;         //触发发送中断
 111   2        }
 112   1      }
 113          
 114          void PrintString1(u8 *puts)
 115          {
 116   1          for (; *puts != 0;  puts++)  TX1_write2buff(*puts);   //遇到停止符0结束
 117   1      }
