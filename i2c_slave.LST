 118          /* 
 119          用页写CAT24WC01 可一次写入8 个字节数据CAT24WC02/04/08/16 可以一次写入16 个字节的 
 120          数据页写操作的启动和字节写一样不同在于传送了一字节数据后并不产生停止信号主器件被允许 
 121          发送P CAT24WC01 P="7" CAT24WC02/04/08/16 P="15" 个额外的字节每发送一个字节数据后 
 122          CAT24WC01/02/04/08/16 产生一个应答位并将字节地址低位加1 高位保持不变 
 123          如果在发送停止信号之前主器件发送超过P+1个字节地址计数器将自动翻转先前写入的数据被 
 124          覆盖 
 125          接收到P+1字节数据和主器件发送的停止信号后CAT24CXXX启动内部写周期将数据写到数据区所 
 126          有接收的数据在一个写周期内写入CAT24WC01/02/04/08/16 
 127          */ 
 128          /* 
 129          选择性读 
 130          选择性读操作允许主器件对寄存器的任意字节进行读操作主器件首先通过发送起始信号从器件 
 131          地址和它想读取的字节数据的地址执行一个伪写操作在CAT24WC01/02/04/08/16 应答之后主器件重 
 132          新发送起始信号和从器件地址此时R/W 位置1 CAT24WC01/02/04/08/16 响应并发送应答信号然后 
 133          输出所要求的一个8 位字节数据主器件不发送应答信号但产生一个停止信号 
 134          */ 
 135          
 136          bit i2c_device_Imitate(uchar *p) 
 137          { 
 138   1        uchar s; 
 139   1        while(!iic_start_wait());//等待IIC开始 
 140   1      
 141   1        s=iic_receive_byte();////器件地址 
 142   1        if(EE_WRITE==s) 
 143   1          { 
 144   2            iic_ack_send(ack); ////回应 
 145   2            s=iic_receive_byte();////存储字节地址 
 146   2            if(EE_BYTEADDR==s) 
 147   2               {
 148   3                  iic_ack_send(ack); ////回应 
 149   3                  s=iic_receive_byte();////存储数据
 150   3                  iic_ack_send(ack); ////回应
 151   3                  //store s here;
 152   3                  gx_get_data = s << 2;
 153   3                  gx_get_data |= 0x03;
 154   3                  P3 = gx_get_data;           
 155   3               }
 156   2            else 
 157   2                { 
 158   3                  iic_ack_send(noack); 
 159   3                  goto enderr; 
 160   3                } 
 161   2          } 
 162   1        else
 163   1          { 
 164   2          iic_ack_send(noack); 
 165   2          goto enderr; 
 166   2          } 
 167   1        if(iic_stop_wait()) 
 168   1          return ture; 
 169   1      enderr: 
 170   1        scl=sda=1; 
 171   1        return false; 
 172   1      }
