 190          void set_i2c_slave(uchar xdevaddr,uchar xbyte_addr,uchar xbyte_data)
 191            {
 192   1          do{
 193   2              do{
 194   3                do{
 195   4                    iicStart(); 
 196   4                    iicwrByte(xdevaddr);  //0xc0
 197   4                    iic_getAck();
 198   4                }while(bACK==1);
 199   3                iicwrByte(xbyte_addr);
 200   3                iic_getAck();
 201   3              }while(bACK==1);
 202   2              iicwrByte(xbyte_data);
 203   2              iic_getAck();
 204   2            }while(bACK==1);
 205   1         iicStop();
 206   1        }
