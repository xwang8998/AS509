 222   3                iicwrByte(RdAddr);
 223   3                iic_getAck();
 224   3                //PTSTA = tst;//tst GPIO
 225   3                //tst = ~tst;  
 226   3                }while(bACK==1);
 227   2              iicStop();  
 228   2              iicStart();
 229   2              iicwrByte(x_wr_devaddr);//0xc1
 230   2              iic_getAck();
 231   2              //PTSTA = tst;//tst GPIO
 232   2              //tst = ~tst;  
 233   2              }while(bACK==1);
 234   1           temp=iicrdByte();
 235   1           iic_send_MACK();
 236   1           iicStop();
 237   1           //PTSTA = tst;//tst GPIO
 238   1           //tst = ~tst;   
